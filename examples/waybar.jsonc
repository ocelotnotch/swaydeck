{
  "modules-right": [
    "custom/swaydeck"
  ],
  "custom/swaydeck": {
    "exec": "exec python3 \"$HOME/.local/bin/swaydeck-waybar\"",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "restart-interval": 3,
    "exec-on-event": false,
    "on-click": "ghostty -e ~/.local/bin/swaydeck"
  }
}
